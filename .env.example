# Copy to backend/.env

# Required — Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key

# Recommended — SerpApi for SERP / People-Also-Ask research (https://serpapi.com)
SERPAPI_KEY=your_serpapi_key

# AWS credentials are NOT set here — run `aws configure` (region ap-south-1).
# Hosting targets (bucket, CloudFront, site URL) default to the values in
# app/config.py; override only for testing:
# S3_BUCKET=
# CLOUDFRONT_DISTRIBUTION_ID=
# SITE_URL=
